# Copy to .env.local for local development. Real values live in the Vercel
# dashboard (Production / Preview). Preview uses the staging Supabase project.
# Never commit real secrets.
#
# Local Supabase: run `npm run db:start`; it prints the URL (API_URL), the anon
# key (ANON_KEY) and the service role key (SERVICE_ROLE_KEY) to use here.
# Reprint them any time with `npx supabase status`.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# https://hallyustars.org in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=

# Delayed chat-email checks (Upstash QStash). Production: the keys from the
# Upstash console, and leave QSTASH_URL unset. Locally: run `npm run qstash`
# and use the values it prints, with QSTASH_URL=http://127.0.0.1:8080.
# Without QSTASH_TOKEN, chat emails are simply not scheduled.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# Email. Locally, EMAIL_TRANSPORT=mailpit sends every email to the local
# Mailpit inbox (http://127.0.0.1:54324) instead of real addresses through
# Resend. Never set it in Vercel.
EMAIL_TRANSPORT=mailpit
RESEND_API_KEY=
# Resend → Webhooks → signing secret of the email.received webhook (whsec_…)
RESEND_WEBHOOK_SECRET=
# Supabase → Auth → Hooks → Send Email (HTTPS) → generated secret (v1,whsec_…).
# Local value (matches supabase/config.toml; not a secret):
SEND_EMAIL_HOOK_SECRET=v1,whsec_aGFsbHl1LXN0YXJzLWxvY2FsLXNlbmQtZW1haWwtaG9vaw==
TRANSLATION_API_KEY=
# Vercel Cron sends it to /api/cron/cleanup (daily cleanup). Any long random
# string, e.g. `openssl rand -hex 32`; locally anything works.
CRON_SECRET=
